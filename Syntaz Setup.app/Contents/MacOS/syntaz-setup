#!/bin/bash
# Syntaz Setup for macOS: opens the Syntaz window (install, update, uninstall). Uses Node.js if this Mac has it,
# otherwise gets its own copy the first time (setup/get-node.sh: no installer, no admin password).
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/Library/Application Support/Syntaz/node/bin:$PATH"
NODE="$(command -v node || true)"
if [ -z "$NODE" ]; then
  osascript -e 'display notification "Getting Syntaz ready (the first time only, about a minute)…" with title "Syntaz AI"' 2>/dev/null
  NODE="$(/bin/bash "$DIR/setup/get-node.sh" 2>/dev/null)" || NODE=""
  if [ -z "$NODE" ]; then
    osascript -e 'display dialog "Syntaz couldn'"'"'t download what it needs. Check your internet connection and open Syntaz Setup again." buttons {"OK"} default button "OK" with title "Syntaz Setup"' 2>/dev/null
    exit 1
  fi
fi
nohup "$NODE" "$DIR/setup/syntaz-app.mjs" >/dev/null 2>&1 &
