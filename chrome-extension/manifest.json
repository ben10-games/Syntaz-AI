{
  "manifest_version": 3,
  "name": "Syntaz AI",
  "version": "2.1.1",
  "description": "Syntaz AI in Chrome's side panel: chat with your own AI (Gemini, OpenAI, Claude, Grok, Groq, Hugging Face) and let it do tasks in your tabs with your approval. No other app needed.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel",
    "contextMenus"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.x.ai/*",
    "https://api.groq.com/*",
    "https://router.huggingface.co/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Syntaz",
    "default_icon": {
      "16": "icons/syntaz-16.png",
      "32": "icons/syntaz-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Open Syntaz"
    }
  },
  "icons": {
    "16": "icons/syntaz-16.png",
    "32": "icons/syntaz-32.png",
    "48": "icons/syntaz-48.png",
    "128": "icons/syntaz-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
